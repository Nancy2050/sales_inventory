<odoo>
    <record id="view_recovery_list" model="ir.ui.view"><field name="name">sales.inventory.recovery.list</field><field name="model">sales.inventory.recovery</field><field name="arch" type="xml">
    <list decoration-success="state == 'released'" decoration-muted="state == 'cancel'"><field name="name"/><field name="date"/><field name="reason"/><field name="amount" sum="Total liberado"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_recovery_form" model="ir.ui.view"><field name="name">sales.inventory.recovery.form</field><field name="model">sales.inventory.recovery</field><field name="arch" type="xml">
    <form string="Liberación de capital">
        <header><button name="action_release" string="Liberar" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" string="Cancelar" type="object" invisible="state != 'released'"/><button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'cancel'"/><field name="state" widget="statusbar" statusbar_visible="draft,released,cancel"/></header>
        <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><field name="date"/><field name="amount" readonly="state != 'draft'"/><field name="reason" readonly="state != 'draft'"/><field name="recovered_used" invisible="state == 'draft'"/><field name="profit_used" invisible="state == 'draft'"/><field name="currency_id" invisible="1"/></group></sheet>
    </form></field></record>
    <record id="action_recoveries" model="ir.actions.act_window"><field name="name">Liberaciones de capital</field><field name="res_model">sales.inventory.recovery</field><field name="view_mode">list,form</field></record>
</odoo>

<odoo>
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">sales.inventory.product.list</field><field name="model">sales.inventory.product</field>
        <field name="arch" type="xml">
        <list decoration-danger="stock_qty == 0" default_order="name">
            <header>
                <button name="action_export_catalog_pdf" type="object" string="Exportar PDF" icon="fa-file-pdf-o" class="btn-primary" display="always"/>
            </header>
            <field name="image_128" widget="image" options="{'size': [48, 48]}" string=""/><field name="name"/><field name="code"/><field name="category_id"/><field name="stock_qty"/>
            <field name="purchase_price"/><field name="suggested_price"/><field name="investment_total" optional="show"/><field name="suggested_total" optional="show"/>
        </list></field>
    </record>
    <record id="view_product_form" model="ir.ui.view">
        <field name="name">sales.inventory.product.form</field><field name="model">sales.inventory.product</field>
        <field name="arch" type="xml">
        <form string="Producto" class="o_si_product_form"><sheet>
            <widget name="web_ribbon" title="Sin existencia" bg_color="text-bg-danger" invisible="stock_qty != 0"/>
            <div class="o_si_product_layout">
                <div class="o_si_product_image"><field name="image_1920" widget="image_crop" options="{'preview_image': 'image_1024', 'zoom': true}"/></div>
                <div class="o_si_product_details">
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group><group><field name="code"/><field name="category_id"/><field name="initial_qty"/></group>
                    <group><field name="stock_qty"/><field name="purchase_price"/><field name="suggested_price"/></group></group>
                </div>
            </div>
            <group string="Valores actuales"><field name="investment_total"/><field name="suggested_total"/><field name="currency_id" invisible="1"/></group>
        </sheet></form></field>
    </record>
    <record id="view_category_list" model="ir.ui.view"><field name="name">sales.inventory.category.list</field><field name="model">sales.inventory.category</field><field name="arch" type="xml">
    <list editable="bottom"><field name="name"/><field name="color" widget="color_picker"/></list></field></record>
    <record id="view_product_search" model="ir.ui.view">
        <field name="name">sales.inventory.product.search</field>
        <field name="model">sales.inventory.product</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="purchase_price"/>
                <field name="suggested_price"/>
                <separator/>
                <filter name="with_stock" string="Con existencia" domain="[('stock_qty', '&gt;', 0)]"/>
                <filter name="without_stock" string="Sin existencia" domain="[('stock_qty', '=', 0)]"/>
                <filter name="pending_review" string="Pendientes de revisar" domain="[('inventory_review_status', '=', 'pending')]"/>
                <separator/>
                <filter name="group_category" string="Agrupar por categoría" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_products" model="ir.actions.act_window"><field name="name">Productos</field><field name="res_model">sales.inventory.product</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_product_search"/></record>
    <record id="action_categories" model="ir.actions.act_window"><field name="name">Categorías</field><field name="res_model">sales.inventory.category</field><field name="view_mode">list</field></record>
</odoo>
